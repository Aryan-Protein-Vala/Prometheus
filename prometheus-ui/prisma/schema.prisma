generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model License {
  id        String   @id @default(uuid())
  key       String   @unique
  email     String
  uses      Int      @default(0)
  maxUses   Int      @default(3)
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
